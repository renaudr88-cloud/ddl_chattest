# Copy to .env and fill in.
PORT=8080
WS_PATH=/chat

# Same long random string as CHAT_SECRET in php/chat-config.php (32+ chars).
# Generate one with:  openssl rand -base64 48
CHAT_SECRET=

# mysql in production, memory for local testing
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Platforms, each with their own rooms. Must match app/src/platforms.js
PLATFORMS=dartsmind,scolia

# Picture URLs must start with this (where php/chat-upload.php saves them)
UPLOAD_BASE_URL=https://ddl-online.com/uploads/chat/

# Only needed if a browser/web version connects. Native apps send no Origin.
ALLOWED_ORIGINS=https://ddl-online.com
