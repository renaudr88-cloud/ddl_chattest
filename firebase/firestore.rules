rules_version = '2';

// DDL Chat - Firestore security rules.
// These rules ARE the server: they decide who may read and write what. The app only mirrors them.
//
// Data
//   users/{uid}                          name, nameLower, role, avatar, lastSeen
//   rooms/{room}/messages/{id}           room = "general:<platform>", "tournament:<platform>" or "dm:<platform>:<uidA>:<uidB>" 
//   dms/{room}                           one per private chat: members, users{uid:{name,role}}, lastAt, lastBy
//   platforms/{p}/friendlies/{id}        "looking for a friendly" cards
//   platforms/{p}/swap/{id}              Dartswap listings
//   platforms/{p}/help/{id}              help desk questions (answers in an array)
//   sanctions/{uid}                      mutedUntil, kickedUntil (timestamps), banned
//   raffleAccess/{uid}                   raffle chat access: name, status pending|approved|declined|removed
//   modlog/{id}                          staff actions
//   premierMembers/{uid}                 Premier League chat (Dartsmind): players staff added {name, by, ts}
//   staff/{uid}                          chat staff: made by a DDL admin {name, by, ts} (or test staff code)
//   config/staff                         test mode only: { code: "..." } (set in the console, unreadable for the app)
//
// Staff (admin): a DDL login with ddlRole "admin" in the token (made by php/chat-login.php),
// or, in test mode, someone who entered the staff code from config/staff.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function platforms() { return ['dartsmind', 'scolia']; }   // keep in sync with app/src/platforms.js
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && (request.auth.token.get('ddlRole', '') == 'admin' || exists(/databases/$(database)/documents/staff/$(me())));
    }
    function isDDLAdmin() { return signedIn() && request.auth.token.get('ddlRole', '') == 'admin'; }   // is_admin on ddl-online.com
    function myRole() { return isAdmin() ? 'admin' : 'player'; }
    function myName() { return get(/databases/$(database)/documents/users/$(me())).data.name; }
    // Profile photo: only the photo from the DDL website (claim ddlPhoto in the token made by php/chat-login.php).
    function avatarOk(d) { return d.get('avatar', null) == request.auth.token.get('ddlPhoto', null); }

    function sanctionOf(uid) {
      return exists(/databases/$(database)/documents/sanctions/$(uid)) ? get(/databases/$(database)/documents/sanctions/$(uid)).data : {};
    }
    function blocked() {
      let s = sanctionOf(me());
      return s.get('banned', false) == true || s.get('kickedUntil', timestamp.value(0)) > request.time;
    }
    function muted() { return sanctionOf(me()).get('mutedUntil', timestamp.value(0)) > request.time; }
    function canRead() { return signedIn() && !blocked(); }
    function canPost() { return canRead() && !muted(); }

    // Bad words (English + Dutch). The app checks first and also catches "f.u.c.k" and "k4nker";
    // these rules stop anyone who skips the app. Keep in line with app/src/filter.js.
    function clean(t) {
      let s = t.lower();
      return !s.matches('(?s).*(fuck|cunt|motherfucker|nigger|faggot|klootzak|kanker|tering|godverdomme).*')
        && !s.matches('(?s)(.*[^a-z])?(fck|fuk|shit|bitch|asshole|arsehole|bastard|dickhead|wanker|twat|prick|slut|whore|retard|nigga|fag|kut|hoer|lul|gvd|mongool|eikel|sukkel|flikker|tyfus|pleuris|debiel|kech)(s|en|ing|ed|er|ers)?([^a-z].*)?');
    }
    function text(t, max) { return t is string && t.size() <= max && clean(t); }
    function picture(u) {
      // Pictures are shrunk by the app and stored in the document itself (JPEG, max ~400 KB).
      return u == null || (u is string && u.size() < 400000 && u.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }
    // Dartswap: up to 3 pictures per listing.
    function photos(l) {
      return l is list && l.size() <= 3
        && (l.size() < 1 || (l[0] is string && picture(l[0])))
        && (l.size() < 2 || (l[1] is string && picture(l[1])))
        && (l.size() < 3 || (l[2] is string && picture(l[2])));
    }
    function inPlatforms(p) { return p in platforms(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Room names: "general:<platform>", "tournament:<platform>" or "dm:<platform>:<uidA>:<uidB>" with uidA < uidB.
    function roomOk(room) {
      let p = room.split(':');
      return (p.size() == 2 && p[0] in ['general', 'tournament'] && inPlatforms(p[1]))
        || (p.size() == 2 && p[0] in ['raffle', 'premier'] && p[1] == 'dartsmind')
        || (p.size() == 4 && p[0] == 'dm' && inPlatforms(p[1]) && p[2] < p[3] && (p[2] == me() || p[3] == me()));
    }

    // Raffle chat: only staff and players whose access request staff approved.
    function raffleApproved() {
      return isAdmin() || (exists(/databases/$(database)/documents/raffleAccess/$(me()))
        && get(/databases/$(database)/documents/raffleAccess/$(me())).data.status == 'approved');
    }
    // Premier League chat: only staff and the players staff put in it (premierMembers/{uid}).
    function premierMember() { return isAdmin() || exists(/databases/$(database)/documents/premierMembers/$(me())); }
    function roomAccess(room) {
      let kind = room.split(':')[0];
      return (kind != 'raffle' || raffleApproved()) && (kind != 'premier' || premierMember());
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn();
      // A DDL login must use the name from its token; in test mode the player picks a name.
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'role', 'avatar', 'lastSeen'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.name == request.auth.token.get('ddlName', request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && (request.auth.token.get('ddlName', null) != null || clean(request.resource.data.name))   // DDL names come from the DDL database
        && request.resource.data.role == myRole()
        && avatarOk(request.resource.data);
    }

    // ---------- messages ----------
    match /rooms/{room}/messages/{id} {
      allow read: if canRead() && roomOk(room) && roomAccess(room);
      allow create: if canPost() && roomOk(room) && roomAccess(room)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'avatar', 'text', 'imageUrl', 'mentions', 'tournament', 'reply', 'ts'])
        // Reply to another message: a short quote of it.
        && (!('reply' in request.resource.data) || (request.resource.data.reply is map
            && request.resource.data.reply.keys().hasOnly(['id', 'name', 'text'])
            && request.resource.data.reply.id is string && request.resource.data.reply.name is string
            && request.resource.data.reply.name.size() <= 30 && text(request.resource.data.reply.text, 120)))
        // A tournament card (id + name of a ddl-online.com tournament): staff only.
        && (!('tournament' in request.resource.data) || (isAdmin() && request.resource.data.tournament is map
            && request.resource.data.tournament.keys().hasOnly(['id', 'name'])
            && request.resource.data.tournament.id is int && request.resource.data.tournament.name is string
            && request.resource.data.tournament.name.size() <= 100))
        && (!('mentions' in request.resource.data) || (request.resource.data.mentions is list && request.resource.data.mentions.size() <= 10))
        && request.resource.data.uid == me()
        && request.resource.data.name == myName() && avatarOk(request.resource.data)
        && request.resource.data.role == myRole()
        && request.resource.data.ts == request.time
        && text(request.resource.data.text, 1000)
        && picture(request.resource.data.get('imageUrl', null))
        && (request.resource.data.text.size() > 0 || request.resource.data.get('imageUrl', null) != null);
      // Reactions: one emoji per player per message (reactions.<uid>), only your own.
      allow update: if canPost() && roomOk(room) && roomAccess(room)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map && request.resource.data.reactions.size() <= 500
        && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()])
        && (!(me() in request.resource.data.reactions) || request.resource.data.reactions[me()] in ['👍', '🎯', '🔥', '😂', '👏', '💯']);
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // ---------- private chat list ----------
    match /dms/{room} {
      allow read: if canRead() && me() in resource.data.members;
      allow create, update: if canPost() && roomOk(room) && room.split(':')[0] == 'dm'
        && request.resource.data.members == [room.split(':')[2], room.split(':')[3]]
        && request.resource.data.platform == room.split(':')[1]
        && request.resource.data.lastBy == me()
        && request.resource.data.lastAt == request.time;
    }

    // ---------- per platform: friendlies, Dartswap, help desk ----------
    match /platforms/{p}/friendlies/{id} {
      allow read: if canRead() && inPlatforms(p);
      allow create: if canPost() && inPlatforms(p)
        && request.resource.data.uid == me() && request.resource.data.name == myName() && avatarOk(request.resource.data)
        && request.resource.data.status == 'open' && request.resource.data.ts == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(16, 'm')   // 15 minutes (+1 for phone clocks)
        && request.resource.data.format in ['FT3', 'FT5', 'Other']
        && request.resource.data.game in ['501', '301', '701', 'Cricket']
        && text(request.resource.data.custom, 40) && text(request.resource.data.note, 120);
      // The player who posted it, or staff, can delete it. Cards expire after 15 minutes (expiresAt).
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      // Owner or staff takes it down; anyone else accepts an open card that has not expired (only once).
      allow update: if canRead() && (
          ((resource.data.uid == me() || isAdmin()) && changed().hasOnly(['status']) && request.resource.data.status == 'cancelled')
          || (canPost() && resource.data.uid != me() && resource.data.status == 'open'
              && resource.data.get('expiresAt', request.time) > request.time
              && changed().hasOnly(['status', 'matchedWith', 'matchedName'])
              && request.resource.data.status == 'matched'
              && request.resource.data.matchedWith == me() && request.resource.data.matchedName == myName()));
    }

    match /platforms/{p}/swap/{id} {
      allow read: if canRead() && inPlatforms(p);
      allow create: if canPost() && inPlatforms(p)
        && request.resource.data.uid == me() && request.resource.data.name == myName() && avatarOk(request.resource.data)
        && request.resource.data.status == 'open' && request.resource.data.ts == request.time
        && request.resource.data.kind in ['Sell', 'Swap', 'Wanted']
        && text(request.resource.data.title, 70) && request.resource.data.title.size() > 0
        && text(request.resource.data.desc, 400) && text(request.resource.data.cond, 20)
        && request.resource.data.price is string && request.resource.data.price.matches('[0-9.,]{0,12}')
        && photos(request.resource.data.get('images', []));
      allow update: if canRead() && changed().hasOnly(['status']) && (
          (resource.data.uid == me() && request.resource.data.status in ['done', 'deleted'])
          || (isAdmin() && request.resource.data.status == 'deleted'));
    }

    match /platforms/{p}/help/{id} {
      // Players see their own questions and the solved ones (a public FAQ). Staff see everything.
      allow read: if canRead() && inPlatforms(p)
        && (isAdmin() || resource.data.uid == me() || resource.data.status == 'solved');
      allow create: if canPost() && inPlatforms(p)
        && request.resource.data.uid == me() && request.resource.data.name == myName() && avatarOk(request.resource.data)
        && request.resource.data.status == 'open' && request.resource.data.ts == request.time
        && request.resource.data.answers == []
        && text(request.resource.data.text, 300) && request.resource.data.text.size() >= 10;
      allow update: if canRead() && (
          isAdmin()
          || (resource.data.uid == me() && changed().hasOnly(['status']) && request.resource.data.status == 'solved'));
    }

    // ---------- raffle access requests ----------
    match /premierMembers/{uid} {
      // Staff add and remove players; a player only sees whether they are in.
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['name', 'by', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.by == me() && request.resource.data.ts == request.time;
      allow delete: if isAdmin();
    }

    match /raffleAccess/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      // A player asks for access (again after a refusal); staff approve, decline or remove.
      allow create: if canPost() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'status', 'ts'])
        && request.resource.data.name == myName() && request.resource.data.status == 'pending'
        && request.resource.data.ts == request.time;
      allow update: if (isAdmin() && changed().hasOnly(['status', 'by', 'decidedAt'])
            && request.resource.data.status in ['approved', 'declined', 'removed'] && request.resource.data.by == me())
        || (canPost() && uid == me() && resource.data.status in ['declined', 'removed']
            && changed().hasOnly(['status', 'ts']) && request.resource.data.status == 'pending' && request.resource.data.ts == request.time);
    }

    // ---------- moderation ----------
    match /sanctions/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      // Staff cannot sanction other staff.
      allow write: if isAdmin() && uid != me()
        && (!exists(/databases/$(database)/documents/users/$(uid)) || get(/databases/$(database)/documents/users/$(uid)).data.role != 'admin');
    }
    match /modlog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == me() && request.resource.data.ts == request.time;
    }

    // ---------- chat staff ----------
    // DDL admins (is_admin on the website) can make a player chat staff, and take it back.
    // In the test version, someone who enters the staff code from config/staff becomes staff too.
    match /staff/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());
      allow create: if (signedIn() && uid == me() && exists(/databases/$(database)/documents/config/staff)
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code == get(/databases/$(database)/documents/config/staff).data.code)
        || (isDDLAdmin() && uid != me()
          && request.resource.data.keys().hasOnly(['name', 'by', 'ts'])
          && request.resource.data.by == me() && request.resource.data.ts == request.time);
      allow delete: if isDDLAdmin();
    }
    match /config/{id} {
      allow read, write: if false;   // set by hand in the Firebase console
    }
  }
}
