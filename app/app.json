{
  "expo": {
    "name": "DDL Chat",
    "slug": "ddl-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#011E51",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#011E51"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose pictures to share in the DDL chat.",
        "NSCameraUsageDescription": "Take photos of your darts gear for Dartswap."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#011E51"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
